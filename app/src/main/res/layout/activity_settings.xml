<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_title" android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/distance_section" android:textColor="@color/safe" android:textStyle="bold" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/warning_distance_label">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/warningDistanceInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/danger_distance_label">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/dangerDistanceInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/speed_section" android:textColor="@color/safe" android:textStyle="bold" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/speedAlertSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/speed_alert_label" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/speed_limit_label">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/speedLimitInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/alert_section" android:textColor="@color/safe" android:textStyle="bold" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/soundSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sound_label" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/vibrationSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/vibration_label" />
        <com.google.android.material.button.MaterialButton android:id="@+id/resetCalibrationButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="24dp" android:text="@string/reset_calibration" style="@style/Widget.Material3.Button.OutlinedButton" />
        <com.google.android.material.button.MaterialButton android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="@string/save" />
    </LinearLayout>
</ScrollView>
